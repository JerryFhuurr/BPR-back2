<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bpr.bprbackend2.mapper.CommentMapper">
    <insert id="addComment" parameterType="com.bpr.bprbackend2.model.Comment">
        INSERT INTO Comment (user_id, course_id, res_id, role_id, comment_text, comment_time, comment_score, sender_id, sender_name)
        VALUES (#{userId}, #{courseId}, #{resId}, #{roleId}, #{commentText}, #{commentTime}, #{commentScore}, #{senderId}, #{senderName})
    </insert>

    <select id="getCommentList" resultType="com.bpr.bprbackend2.model.Comment">
        SELECT *
        FROM Comment
        WHERE res_id=#{resId}
    </select>

    <select id="getCommentListByUser" resultType="com.bpr.bprbackend2.model.Comment">
        SELECT *
        FROM Comment
        WHERE sender_id=#{senderId}
    </select>

    <delete id="removeComment">
        DELETE FROM Comment WHERE comment_id=#{commentId}
    </delete>

    <delete id="removeCommentByVideo">
        DELETE FROM Comment WHERE res_id=#{resId}
    </delete>

    <select id="getAComment" resultType="com.bpr.bprbackend2.model.Comment">
        SELECT *
        FROM Comment
        WHERE comment_id=#{commentId}
    </select>

    <update id="updateComment" parameterType="com.bpr.bprbackend2.model.Comment">
        UPDATE Comment
        SET comment_text=#{commentText}, comment_time=#{commentTime}, comment_score=#{commentScore}
        WHERE sender_id=#{senderId}
    </update>

</mapper>