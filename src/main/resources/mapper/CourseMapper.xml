<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bpr.bprbackend2.mapper.CourseMapper">

    <select id="getCourseByUser" resultType="com.bpr.bprbackend2.model.Course">
        SELECT C.course_name, C.course_id
        FROM Course C
                 JOIN CourseUser CU ON C.course_id = CU.course_id
                 JOIN User U ON CU.user_id = U.user_id
        WHERE U.username = #{username}
    </select>

    <select id="getCourseList" resultType="com.bpr.bprbackend2.model.Course">
        SELECT *
        FROM Course
    </select>
</mapper>