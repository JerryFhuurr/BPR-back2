<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bpr.bprbackend2.mapper.HistoryMapper">
    <insert id="addHistory" parameterType="com.bpr.bprbackend2.model.History">
        INSERT INTO History (user_id, course_id, video_id, role_id, watcher_id, watch_time)
        VALUES (#{userId}, #{courseId}, #{videoId}, #{roleId}, #{watcherId}, #{watchTime})
    </insert>

    <select id="getHistoryList" resultType="com.bpr.bprbackend2.model.History">
        SELECT *
        FROM History
        WHERE watcher_id = #{watcherId}
    </select>

    <delete id="removeHistory">
        DELETE FROM History WHERE h_id = #{hId}
    </delete>

    <update id="updateHistory" parameterType="com.bpr.bprbackend2.model.History">
        UPDATE History
        SET watch_time = #{watchTime}
        WHERE h_id = #{hId}
    </update>
</mapper>